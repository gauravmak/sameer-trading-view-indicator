//@version=6
// Option Pulse DAILY ITM SIMULATOR (rebuild) — run on the NSE:NIFTY (or BANKNIFTY) index chart, 1-minute, regular candles.
// Each day: call strike = day's open rounded DOWN to 100, put strike = rounded UP to 100 (the paid "100-point ITM" method).
// Both legs are traded with the VWAP-cross rule: buy when a 1-minute candle closes above that option's green line
// (monthly anchored VWAP of the option), exit when a candle closes below it or at +N points, whichever first.
// TradingView strategies can only trade the chart symbol, so this script keeps its own ledger and shows the stats in a table.
// Limits: only contracts TradingView still has data for (the live expiry), and at most ~20 distinct strikes (40 symbols).
// This file uses normal indentation: paste it from a laptop, not a phone.
indicator("Option Pulse Daily ITM Simulator", shorttitle = "OPP-SIM", overlay = false, max_bars_back = 500)

// ───────── Inputs ─────────
grpC = "Contracts"
rootIn = input.string("Auto", "Underlying", options = ["Auto", "NIFTY", "BANKNIFTY", "SENSEX"], group = grpC)
expiryMode = input.string("Auto (next Tuesday)", "Expiry", options = ["Auto (next Tuesday)", "Manual"], group = grpC)
manExpiry = input.string("", "Manual expiry YYMMDD (e.g. 261117)", group = grpC)
roundStep = input.int(100, "Strike rounding step", minval = 50, step = 50, group = grpC)
tradeCE = input.bool(true, "Trade the call", group = grpC)
tradePE = input.bool(true, "Trade the put", group = grpC)
grpR = "Rule"
targetPts = input.float(40, "Target in premium points", minval = 1, step = 5, group = grpR)
maxEntries = input.int(1, "Max entries per leg per day", minval = 1, group = grpR)
enterIfAbove = input.bool(true, "Enter at session start if already above the green line", group = grpR)
entryBuf = input.float(0, "Entry buffer: close must be this many points above the line", minval = 0, step = 1, group = grpR)
stopSrc = input.string("OPP Main Trend line (blue)", "Stop line", options = ["OPP Main Trend line (blue)", "Green line (VWAP)"], group = grpR)
stopTrig = input.string("Price goes below (low)", "Stop trigger", options = ["Price goes below (low)", "Close below"], group = grpR)
exitBuf = input.float(0, "Exit buffer: price must be this many points below the stop line", minval = 0, step = 1, group = grpR)
requireOther = input.bool(true, "Require the other leg to be below its green line (CE buy needs PE below, PE buy needs CE below)", group = grpR)
requireMT = input.bool(false, "Require that leg's Main Trend to be bullish (blue)", group = grpR)
mtLen = input.int(62, "Main Trend length", minval = 1, group = grpR)
mtAtr = input.int(14, "Main Trend ATR period", minval = 1, group = grpR)
mtFactor = input.float(2.0, "Main Trend ATR factor", minval = 0.1, step = 0.1, group = grpR)
lotUnits = input.int(75, "Units per lot (NIFTY 75)", minval = 1, group = grpR)
lots = input.int(1, "Lots per trade", minval = 1, group = grpR)
costPerOrder = input.float(40, "Cost per order (Rs)", minval = 0, group = grpR)
skipOpenMin = input.int(1, "No entries in the first N minutes", minval = 1, group = grpR)
noEntryAfterHHMM = input.int(1500, "No new entries after (HHMM)", minval = 0, maxval = 2359, group = grpR)
squareOffHHMM = input.int(1515, "Square-off time (HHMM)", minval = 0, maxval = 2359, group = grpR)

// ───────── Expiry & strikes ─────────
TZ = "Asia/Kolkata"
MS_DAY = 86400000
pad2(int n) => (n < 10 ? "0" : "") + str.tostring(n)
tk = str.upper(syminfo.ticker)
autoRoot = str.contains(tk, "BANKNIFTY") ? "BANKNIFTY" : str.contains(tk, "SENSEX") ? "SENSEX" : "NIFTY"
root = rootIn == "Auto" ? autoRoot : rootIn
ex = root == "SENSEX" ? "BSE" : "NSE"
pastClose(int t) => hour(t, TZ) > 15 or (hour(t, TZ) == 15 and minute(t, TZ) >= 30)
aheadRaw = (dayofweek.tuesday - dayofweek(timenow, TZ) + 7) % 7
ahead = aheadRaw == 0 and pastClose(timenow) ? 7 : aheadRaw
expTs = timenow + ahead * MS_DAY
useMan = expiryMode == "Manual" and str.length(manExpiry) == 6
expTxt = useMan ? manExpiry : pad2(year(expTs, TZ) % 100) + pad2(month(expTs, TZ)) + pad2(dayofmonth(expTs, TZ))

newDay = timeframe.change("1D")
var float dayOpen = na
dayOpen := newDay ? open : dayOpen
var int sessStart = na
sessStart := newDay ? time : sessStart
minsIn = na(sessStart) ? 999 : (time - sessStart) / 60000
hhmm = hour(time, TZ) * 100 + minute(time, TZ)
ceK = math.floor(dayOpen / roundStep) * roundStep
peK0 = math.ceil(dayOpen / roundStep) * roundStep
peK = peK0 == ceK ? peK0 + roundStep : peK0
ceSym = ex + ":" + root + expTxt + "C" + str.tostring(ceK, "#")
peSym = ex + ":" + root + expTxt + "P" + str.tostring(peK, "#")

// ───────── Option prices and their green lines ─────────
[ceC, ceH, ceL, ceV, ceVw] = request.security(ceSym, timeframe.period, [close, high, low, volume, ta.vwap(hlc3, bar_index == 0 or timeframe.change("1M"))], ignore_invalid_symbol = true)
[peC, peH, peL, peV, peVw] = request.security(peSym, timeframe.period, [close, high, low, volume, ta.vwap(hlc3, bar_index == 0 or timeframe.change("1M"))], ignore_invalid_symbol = true)
// Main Trend per leg (same maths as the overlay)
ceHLC = (ceH + ceL + ceC) / 3
ceVsum = math.sum(nz(ceV), mtLen)
var float ceCen = na
ceCen := na(ceCen[1]) ? ceHLC : ceVsum > 0 ? ceCen[1] * (ceVsum - nz(ceV)) / ceVsum + nz(ceV) * ceHLC / ceVsum : ceCen[1]
ceTR = math.max(ceH - ceL, math.abs(ceH - nz(ceC[1], ceC)), math.abs(ceL - nz(ceC[1], ceC)))
ceAtr = ta.rma(ceTR, mtAtr)
var int ceDir = 1
ceDir := nz(ceDir[1], 1) == 1 and ceC > ceCen + mtFactor * ceAtr ? -1 : nz(ceDir[1], 1) == -1 and ceC < ceCen - mtFactor * ceAtr ? 1 : nz(ceDir[1], 1)
peHLC = (peH + peL + peC) / 3
peVsum = math.sum(nz(peV), mtLen)
var float peCen = na
peCen := na(peCen[1]) ? peHLC : peVsum > 0 ? peCen[1] * (peVsum - nz(peV)) / peVsum + nz(peV) * peHLC / peVsum : peCen[1]
peTR = math.max(peH - peL, math.abs(peH - nz(peC[1], peC)), math.abs(peL - nz(peC[1], peC)))
peAtr = ta.rma(peTR, mtAtr)
var int peDir = 1
peDir := nz(peDir[1], 1) == 1 and peC > peCen + mtFactor * peAtr ? -1 : nz(peDir[1], 1) == -1 and peC < peCen - mtFactor * peAtr ? 1 : nz(peDir[1], 1)
ceAbove = ceC > ceVw + entryBuf
peAbove = peC > peVw + entryBuf
ceStopLine = (stopSrc == "Green line (VWAP)" ? ceVw : ceCen - mtFactor * ceAtr) - exitBuf
peStopLine = (stopSrc == "Green line (VWAP)" ? peVw : peCen - mtFactor * peAtr) - exitBuf
ceBelow = stopTrig == "Close below" ? ceC < ceStopLine : ceL < ceStopLine
peBelow = stopTrig == "Close below" ? peC < peStopLine : peL < peStopLine
ceMtOk = not requireMT or ceDir == -1
peMtOk = not requireMT or peDir == -1
ceOtherOk = not requireOther or (not na(peC) and not na(peVw) and peC < peVw)
peOtherOk = not requireOther or (not na(ceC) and not na(ceVw) and ceC < ceVw)
// a cross is only valid inside the same day (the contract can change at the day boundary)
canEnter = minsIn >= skipOpenMin and hhmm < noEntryAfterHHMM and hhmm < squareOffHHMM and barstate.isconfirmed
firstEligible = minsIn >= skipOpenMin and minsIn[1] < skipOpenMin
ceCross = (ceAbove and not ceAbove[1] and not newDay and not na(ceC[1])) or (enterIfAbove and firstEligible and ceAbove)
peCross = (peAbove and not peAbove[1] and not newDay and not na(peC[1])) or (enterIfAbove and firstEligible and peAbove)
var int ceEntriesToday = 0
var int peEntriesToday = 0
ceEntriesToday := newDay ? 0 : ceEntriesToday
peEntriesToday := newDay ? 0 : peEntriesToday
isSquareOff = hhmm >= squareOffHHMM
unitsPerTrade = lotUnits * lots
roundTripCost = 2 * costPerOrder

// ───────── Ledger ─────────
var int nTrades = 0
var int nWins = 0
var float grossWin = 0.0
var float grossLoss = 0.0
var float netPnl = 0.0
var float peakPnl = 0.0
var float maxDD = 0.0
var int ceTrades = 0
var float cePnl = 0.0
var int peTrades = 0
var float pePnl = 0.0
var int exitsTarget = 0
var int exitsVwap = 0
var int exitsSquare = 0

// CE leg
var bool ceIn = false
var float ceEntry = na
if ceIn
    hitTarget = ceC >= ceEntry + targetPts
    exitNow = hitTarget or ceBelow or isSquareOff or na(ceC)
    if exitNow
        exitPx = hitTarget ? ceEntry + targetPts : ceBelow ? math.min(ceStopLine + exitBuf, nz(ceC, ceEntry)) : nz(ceC, ceEntry)
        pnl = (exitPx - ceEntry) * unitsPerTrade - roundTripCost
        nTrades += 1
        nWins += pnl > 0 ? 1 : 0
        grossWin += pnl > 0 ? pnl : 0
        grossLoss += pnl < 0 ? -pnl : 0
        netPnl += pnl
        peakPnl := math.max(peakPnl, netPnl)
        maxDD := math.max(maxDD, peakPnl - netPnl)
        ceTrades += 1
        cePnl += pnl
        exitsTarget += hitTarget ? 1 : 0
        exitsVwap += not hitTarget and ceBelow ? 1 : 0
        exitsSquare += not hitTarget and not ceBelow ? 1 : 0
        ceIn := false
if not ceIn and tradeCE and canEnter and ceCross and ceMtOk and ceOtherOk and ceEntriesToday < maxEntries
    ceIn := true
    ceEntry := ceC
    ceEntriesToday += 1

// PE leg
var bool peIn = false
var float peEntry = na
if peIn
    hitTargetP = peC >= peEntry + targetPts
    exitNowP = hitTargetP or peBelow or isSquareOff or na(peC)
    if exitNowP
        exitPxP = hitTargetP ? peEntry + targetPts : peBelow ? math.min(peStopLine + exitBuf, nz(peC, peEntry)) : nz(peC, peEntry)
        pnlP = (exitPxP - peEntry) * unitsPerTrade - roundTripCost
        nTrades += 1
        nWins += pnlP > 0 ? 1 : 0
        grossWin += pnlP > 0 ? pnlP : 0
        grossLoss += pnlP < 0 ? -pnlP : 0
        netPnl += pnlP
        peakPnl := math.max(peakPnl, netPnl)
        maxDD := math.max(maxDD, peakPnl - netPnl)
        peTrades += 1
        pePnl += pnlP
        exitsTarget += hitTargetP ? 1 : 0
        exitsVwap += not hitTargetP and peBelow ? 1 : 0
        exitsSquare += not hitTargetP and not peBelow ? 1 : 0
        peIn := false
if not peIn and tradePE and canEnter and peCross and peMtOk and peOtherOk and peEntriesToday < maxEntries
    peIn := true
    peEntry := peC
    peEntriesToday += 1

// ───────── Output ─────────
plot(netPnl, "Equity (Rs)", color = color.new(#26a69a, 0), linewidth = 2)
plot(0, "Zero", color = color.new(#9e9e9e, 60))
bgcolor(ceIn ? color.new(#26a69a, 90) : na, title = "CE in trade")
bgcolor(peIn ? color.new(#ef5350, 90) : na, title = "PE in trade")
pf = grossLoss > 0 ? grossWin / grossLoss : na
var table tbl = table.new(position.top_right, 2, 12, border_width = 1)
if barstate.islast
    hb = color.new(#263238, 0)
    table.cell(tbl, 0, 0, "OPP Daily ITM Simulator", text_color = color.white, bgcolor = hb, text_size = size.small)
    table.cell(tbl, 1, 0, root + "  expiry " + expTxt, text_color = color.white, bgcolor = hb, text_size = size.small)
    table.cell(tbl, 0, 1, "Today's contracts", text_size = size.small)
    table.cell(tbl, 1, 1, ceSym + "  /  " + peSym + "  (open " + str.tostring(dayOpen, "#") + ")", text_size = size.small)
    table.cell(tbl, 0, 2, "Data found", text_size = size.small)
    table.cell(tbl, 1, 2, (na(ceC) ? "CE: no" : "CE: yes") + "   " + (na(peC) ? "PE: no" : "PE: yes"), text_size = size.small)
    table.cell(tbl, 0, 3, "Trades (CE / PE)", text_size = size.small)
    table.cell(tbl, 1, 3, str.tostring(nTrades) + "  (" + str.tostring(ceTrades) + " / " + str.tostring(peTrades) + ")", text_size = size.small)
    table.cell(tbl, 0, 4, "Win rate", text_size = size.small)
    table.cell(tbl, 1, 4, nTrades > 0 ? str.tostring(100.0 * nWins / nTrades, "#.#") + "%" : "-", text_size = size.small)
    table.cell(tbl, 0, 5, "Profit factor", text_size = size.small)
    table.cell(tbl, 1, 5, na(pf) ? "-" : str.tostring(pf, "#.##"), text_size = size.small)
    table.cell(tbl, 0, 6, "Net PnL (Rs, after costs)", text_size = size.small)
    table.cell(tbl, 1, 6, str.tostring(netPnl, "#"), text_color = netPnl >= 0 ? color.new(#26a69a, 0) : color.new(#ef5350, 0), text_size = size.small)
    table.cell(tbl, 0, 7, "CE PnL / PE PnL", text_size = size.small)
    table.cell(tbl, 1, 7, str.tostring(cePnl, "#") + " / " + str.tostring(pePnl, "#"), text_size = size.small)
    table.cell(tbl, 0, 8, "Max drawdown (Rs)", text_size = size.small)
    table.cell(tbl, 1, 8, str.tostring(maxDD, "#"), text_size = size.small)
    table.cell(tbl, 0, 9, "Avg per trade (Rs)", text_size = size.small)
    table.cell(tbl, 1, 9, nTrades > 0 ? str.tostring(netPnl / nTrades, "#") : "-", text_size = size.small)
    table.cell(tbl, 0, 10, "Exits: target / stop / square-off", text_size = size.small)
    table.cell(tbl, 1, 10, str.tostring(exitsTarget) + " / " + str.tostring(exitsVwap) + " / " + str.tostring(exitsSquare), text_size = size.small)
    table.cell(tbl, 0, 11, "Rule", text_size = size.small)
    table.cell(tbl, 1, 11, "buy close > green" + (entryBuf > 0 ? "+" + str.tostring(entryBuf, "#") : "") + ", stop " + (stopSrc == "Green line (VWAP)" ? "green" : "OPP blue") + (stopTrig == "Close below" ? " (close)" : " (touch)") + (exitBuf > 0 ? "-" + str.tostring(exitBuf, "#") : "") + " or +" + str.tostring(targetPts, "#") + " pts, max " + str.tostring(maxEntries) + "/day" + (requireOther ? ", other leg below" : "") + (requireMT ? ", MT blue" : "") + (enterIfAbove ? ", enter if above at start" : ""), text_size = size.small)
