//@version=6
// Option Pulse Pro (rebuild) — OVERLAY for an option contract's own chart (e.g. NSE:NIFTY261117C24900, 1-minute).
// Components mirror the original:
//   Institutional Breakout Zone  = anchored VWAP (green), anchored to the first bar of the contract's loaded data
//                                  (this matched the paid indicator to within 0.1 on 9 Nov 2026)
//   Main Trend - ITM             = volume-weighted centre (elastic VWMA) ± factor × ATR, shown as the lower band while
//                                  bullish (blue) and the upper band while bearish (pink); flips when close crosses it.
//                                  Fitted to the paid indicator's exported CE and PE values with volume (EVWMA 62 of hlc3, ATR 14, factor 2.0).
//   Running Trend - Pullback Zone = fast EMA running line, with the pullback wedge filled between the Main Trend line
//                                  and that running line (green while bullish / pink while bearish)
//   Today's High/Low lines (optional), background colour
// Extra: finds the opposite leg (same strike & expiry, CE<->PE) and shows the combined CE/PE state with futures OI.
// Zero indented lines on purpose, so it survives pasting from a phone browser.
indicator("Option Pulse Pro (rebuild)", shorttitle = "OPP", overlay = true, scale = scale.right, max_bars_back = 1000)

// ───────── Inputs ─────────
grpM = "Main settings"
showInst = input.bool(true, "Institutional Breakout Zone (anchored VWAP)", group = grpM)
instAnchor = input.string("Contract", "VWAP anchor", options = ["Contract", "Session", "Week", "Month"], group = grpM)
showMain = input.bool(true, "Main Trend - ITM (volume-weighted band)", group = grpM)
mtLen = input.int(62, "Main Trend length (elastic VWMA of hlc3)", minval = 1, group = grpM)
mtAtr = input.int(14, "Main Trend ATR period", minval = 1, group = grpM)
mtFactor = input.float(2.0, "Main Trend ATR factor", minval = 0.1, step = 0.1, group = grpM)
showRun = input.bool(true, "Running Trend - Pullback Zone (running line + wedge)", group = grpM)
runFast = input.int(9, "Running Trend EMA length", minval = 1, group = grpM)
showPair = input.bool(false, "Extra: second EMA with small cloud (not in the original)", group = grpM)
runSlow = input.int(21, "Extra: second EMA length", minval = 1, group = grpM)
showHL = input.bool(false, "Today's High/Low lines", group = grpM)
zoneRef = input.string("Institutional VWAP", "Above/below zone is judged against", options = ["Institutional VWAP", "Main Trend", "Running Trend cloud"], group = grpM)
grpP = "Opposite leg"
autoPair = input.bool(true, "Auto-detect opposite leg from chart symbol", group = grpP)
manPartner = input.string("", "Manual opposite-leg symbol (overrides)", group = grpP)
grpO = "Open-interest confirmation (futures)"
useFutOI = input.bool(true, "Confirm setups with futures OI", group = grpO)
oiLookback = input.int(5, "OI / price change lookback (bars)", minval = 1, group = grpO)
futSuffix = input.string("1!", "Futures contract suffix", group = grpO)
grpD = "Display"
showBg = input.bool(false, "Background colour", group = grpD)
showLabel = input.bool(true, "Pane label", group = grpD)
showTable = input.bool(true, "CE/PE table", group = grpD)
tablePos = input.string("Top right", "Table position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = grpD)

// ───────── Helpers ─────────
oiClass(float p, float oi) => na(p - p[oiLookback]) or na(oi - oi[oiLookback]) ? "n/a" : p > p[oiLookback] and oi > oi[oiLookback] ? "Long buildup" : p > p[oiLookback] and oi < oi[oiLookback] ? "Short covering" : p < p[oiLookback] and oi > oi[oiLookback] ? "Short buildup" : p < p[oiLookback] and oi < oi[oiLookback] ? "Long unwinding" : "Flat"
posLine(float c, float l) => na(c) or na(l) ? 0 : c > l ? 1 : c < l ? -1 : 0
posBand(float c, float a, float b) => na(c) or na(a) or na(b) ? 0 : c > math.max(a, b) ? 1 : c < math.min(a, b) ? -1 : 0
posDir(float d) => na(d) ? 0 : d < 0 ? 1 : -1
posText(int p) => p == 1 ? "Above zone" : p == -1 ? "Below zone" : "Inside zone"
fmt(float v) => na(v) ? "n/a" : str.tostring(v, format.mintick)
fmtOI(float v) => na(v) ? "n/a" : str.tostring(v, "#")

// ───────── Parse the chart symbol: ROOT + yymmdd + C/P + strike ─────────
tkRaw = str.upper(syminfo.ticker)
stdId = ticker.standard(syminfo.tickerid)
isHA = str.contains(syminfo.tickerid, "HeikenAshi")
optMatchRaw = str.match(tkRaw, "\\d{6}[CP]\\d+$")
optPart = na(optMatchRaw) ? "" : optMatchRaw
isOpt = str.length(optPart) > 7
optRoot = isOpt ? str.substring(tkRaw, 0, str.length(tkRaw) - str.length(optPart)) : ""
optExp = isOpt ? str.substring(optPart, 0, 6) : ""
optType = isOpt ? str.substring(optPart, 6, 7) : ""
optStrike = isOpt ? str.substring(optPart, 7) : ""
partnerType = optType == "C" ? "P" : "C"
autoPartner = isOpt ? syminfo.prefix + ":" + optRoot + optExp + partnerType + optStrike : stdId
partnerSym = manPartner != "" ? manPartner : autoPair ? autoPartner : stdId
partnerReq = isHA ? ticker.heikinashi(partnerSym) : partnerSym
hasPartner = manPartner != "" or (autoPair and isOpt)
autoRoot = str.contains(tkRaw, "BANKNIFTY") ? "BANKNIFTY" : str.contains(tkRaw, "FINNIFTY") ? "FINNIFTY" : str.contains(tkRaw, "MIDCPNIFTY") ? "MIDCPNIFTY" : str.contains(tkRaw, "SENSEX") ? "SENSEX" : str.contains(tkRaw, "NIFTY") ? "NIFTY" : tkRaw
root = isOpt ? optRoot : autoRoot
futSym = syminfo.prefix + ":" + root + futSuffix

// ───────── This leg ─────────
newDay = timeframe.change("1D")
anchorNow = instAnchor == "Contract" ? bar_index == 0 : instAnchor == "Session" ? newDay : instAnchor == "Week" ? timeframe.change("1W") : timeframe.change("1M")
inst = ta.vwap(hlc3, anchorNow)
vSum = math.sum(volume, mtLen)
var float mtCen = na
mtCen := na(mtCen[1]) ? hlc3 : vSum > 0 ? mtCen[1] * (vSum - volume) / vSum + volume * hlc3 / vSum : mtCen[1]
mtAtrV = ta.atr(mtAtr)
mtUp = mtCen + mtFactor * mtAtrV
mtLo = mtCen - mtFactor * mtAtrV
var int mtDirI = 1
mtDirI := nz(mtDirI[1], 1) == 1 and close > mtUp ? -1 : nz(mtDirI[1], 1) == -1 and close < mtLo ? 1 : nz(mtDirI[1], 1)
stDir = float(mtDirI)
stLine = mtDirI == -1 ? mtLo : mtUp
runF = ta.ema(close, runFast)
runS = ta.ema(close, runSlow)
runUp = runF > runS
var float dayH = na
var float dayL = na
dayH := newDay ? high : math.max(nz(dayH, high), high)
dayL := newDay ? low : math.min(nz(dayL, low), low)
thisPos = zoneRef == "Institutional VWAP" ? posLine(close, inst) : zoneRef == "Main Trend" ? posDir(stDir) : posBand(close, runF, runS)

// ───────── Opposite leg (same maths on its own chart; Heikin Ashi if this chart is) ─────────
[pC, pH, pL, pV, pInst, pRunF, pRunS] = request.security(partnerReq, timeframe.period, [close, high, low, volume, ta.vwap(hlc3, anchorNow), ta.ema(close, runFast), ta.ema(close, runSlow)], ignore_invalid_symbol = true)
pVsum = math.sum(nz(pV), mtLen)
var float pCen = na
pHLC3 = (pH + pL + pC) / 3
pCen := na(pCen[1]) ? pHLC3 : pVsum > 0 ? pCen[1] * (pVsum - nz(pV)) / pVsum + nz(pV) * pHLC3 / pVsum : pCen[1]
pTR = math.max(pH - pL, math.abs(pH - nz(pC[1], pC)), math.abs(pL - nz(pC[1], pC)))
pAtrV = ta.rma(pTR, mtAtr)
pUp = pCen + mtFactor * pAtrV
pLo = pCen - mtFactor * pAtrV
var int pDirI = 1
pDirI := nz(pDirI[1], 1) == 1 and pC > pUp ? -1 : nz(pDirI[1], 1) == -1 and pC < pLo ? 1 : nz(pDirI[1], 1)
pStDir = float(pDirI)
pStLine = pDirI == -1 ? pLo : pUp
partnerPos = not hasPartner ? 0 : zoneRef == "Institutional VWAP" ? posLine(pC, pInst) : zoneRef == "Main Trend" ? posDir(pStDir) : posBand(pC, pRunF, pRunS)

// ───────── Futures open interest ─────────
futC = request.security(futSym, timeframe.period, close, ignore_invalid_symbol = true)
futOI = request.security(futSym + "_OI", timeframe.period, close, ignore_invalid_symbol = true)
futClass = oiClass(futC, futOI)
bullOI = not useFutOI or futClass == "Long buildup" or futClass == "Short covering"
bearOI = not useFutOI or futClass == "Short buildup" or futClass == "Long unwinding"

// ───────── Combined CE/PE state ─────────
thisIsCE = optType != "P"
cePos = thisIsCE ? thisPos : partnerPos
pePos = thisIsCE ? partnerPos : thisPos
zoneBias = not hasPartner ? 0 : cePos == 1 and pePos == -1 ? 1 : pePos == 1 and cePos == -1 ? -1 : cePos == -1 and pePos == -1 ? 2 : 0
state = zoneBias == 1 and bullOI ? "LONG SETUP" : zoneBias == -1 and bearOI ? "SHORT SETUP" : zoneBias == 2 ? "PREMIUM DECAY" : zoneBias == 1 ? "LONG (no OI confirm)" : zoneBias == -1 ? "SHORT (no OI confirm)" : hasPartner ? "NEUTRAL" : (thisPos == 1 ? "ABOVE ZONE" : thisPos == -1 ? "BELOW ZONE" : "INSIDE ZONE")
colUp = color.new(#26a69a, 0)
colDn = color.new(#ef5350, 0)
colGrey = color.new(#9e9e9e, 0)
stateCol = state == "LONG SETUP" ? colUp : state == "SHORT SETUP" ? colDn : state == "PREMIUM DECAY" ? colGrey : zoneBias == 1 ? color.new(#26a69a, 40) : zoneBias == -1 ? color.new(#ef5350, 40) : thisPos == 1 ? color.new(#26a69a, 40) : thisPos == -1 ? color.new(#ef5350, 40) : color.new(#607d8b, 50)

// ───────── Drawing ─────────
plot(showInst ? inst : na, "Institutional Breakout Zone", color = color.new(#43a047, 0), linewidth = 2)
plMain = plot(showMain ? stLine : na, "Main Trend - ITM", color = stDir < 0 ? color.new(#1e88e5, 0) : color.new(#ec407a, 0), linewidth = 2, style = plot.style_linebr)
plRunF = plot(showRun ? runF : na, "Running Trend", color = stDir < 0 ? color.new(#26a69a, 30) : color.new(#ef5350, 30), linewidth = 1)
plRunS = plot(showPair ? runS : na, "Extra second EMA", color = color.new(#f8bbd0, 0), linewidth = 1)
plWedge = plot(showRun ? runF : na, "Pullback wedge edge", color = color.new(#000000, 100), editable = false)
fill(plMain, plWedge, color = showRun and showMain ? (stDir < 0 ? color.new(#26a69a, 85) : color.new(#ef5350, 85)) : na, title = "Pullback wedge")
fill(plRunF, plRunS, color = showPair ? (runUp ? color.new(#26a69a, 70) : color.new(#ef5350, 70)) : na, title = "Extra EMA cloud")
plot(showHL ? dayH : na, "Today's high", color = color.new(#ffb300, 0), style = plot.style_stepline)
plot(showHL ? dayL : na, "Today's low", color = color.new(#ffb300, 0), style = plot.style_stepline)
bgcolor(showBg ? (thisPos == 1 ? color.new(#26a69a, 88) : thisPos == -1 ? color.new(#ef5350, 88) : na) : na, title = "Background")
var label lb = label.new(bar_index, high, "", style = label.style_label_left, textcolor = color.white, color = stateCol, size = size.small)
label.set_xy(lb, bar_index, high)
label.set_text(lb, showLabel ? (isOpt ? (thisIsCE ? "CE " : "PE ") : "") + posText(thisPos) + "\n" + state : "")
label.set_color(lb, showLabel ? stateCol : color.new(#000000, 100))
label.set_textcolor(lb, showLabel ? color.white : color.new(#000000, 100))

// ───────── Table ─────────
tPos = tablePos == "Top right" ? position.top_right : tablePos == "Top left" ? position.top_left : tablePos == "Bottom right" ? position.bottom_right : position.bottom_left
var table dash = table.new(tPos, 3, 6, border_width = 1, border_color = color.new(#000000, 70))
hdrBg = color.new(#263238, 0)
cellBg = color.new(#37474f, 20)
txtC = color.white
hide = color.new(#000000, 100)
cb = showTable ? cellBg : hide
hb = showTable ? hdrBg : hide
tc = showTable ? txtC : hide
thisName = isOpt ? (thisIsCE ? "CE (this chart)" : "PE (this chart)") : "This chart"
partnerName = isOpt ? (thisIsCE ? "PE (other leg)" : "CE (other leg)") : "Other leg"
table.cell(dash, 0, 0, showTable ? "Option Pulse Pro v1.3" : "", text_color = tc, bgcolor = hb, text_size = size.small)
table.cell(dash, 1, 0, showTable ? thisName : "", text_color = tc, bgcolor = hb, text_size = size.small)
table.cell(dash, 2, 0, showTable ? partnerName : "", text_color = tc, bgcolor = hb, text_size = size.small)
table.cell(dash, 0, 1, showTable ? "Symbol" : "", text_color = tc, bgcolor = cb, text_size = size.small)
table.cell(dash, 1, 1, showTable ? stdId : "", text_color = tc, bgcolor = cb, text_size = size.small)
table.cell(dash, 2, 1, showTable ? (hasPartner ? partnerSym : "not detected") : "", text_color = tc, bgcolor = cb, text_size = size.small)
table.cell(dash, 0, 2, showTable ? "Premium / VWAP" : "", text_color = tc, bgcolor = cb, text_size = size.small)
table.cell(dash, 1, 2, showTable ? fmt(close) + " / " + fmt(inst) : "", text_color = tc, bgcolor = cb, text_size = size.small)
table.cell(dash, 2, 2, showTable ? (hasPartner ? fmt(pC) + " / " + fmt(pInst) : "-") : "", text_color = tc, bgcolor = cb, text_size = size.small)
table.cell(dash, 0, 3, showTable ? "Main Trend" : "", text_color = tc, bgcolor = cb, text_size = size.small)
table.cell(dash, 1, 3, showTable ? (stDir < 0 ? "Bullish" : "Bearish") + " " + fmt(stLine) : "", text_color = showTable ? (stDir < 0 ? colUp : colDn) : hide, bgcolor = cb, text_size = size.small)
table.cell(dash, 2, 3, showTable ? (hasPartner ? (pStDir < 0 ? "Bullish" : "Bearish") + " " + fmt(pStLine) : "-") : "", text_color = showTable ? (pStDir < 0 ? colUp : colDn) : hide, bgcolor = cb, text_size = size.small)
table.cell(dash, 0, 4, showTable ? "Position" : "", text_color = tc, bgcolor = cb, text_size = size.small)
table.cell(dash, 1, 4, showTable ? posText(thisPos) : "", text_color = showTable ? (thisPos == 1 ? colUp : thisPos == -1 ? colDn : txtC) : hide, bgcolor = cb, text_size = size.small)
table.cell(dash, 2, 4, showTable ? (hasPartner ? posText(partnerPos) : "-") : "", text_color = showTable ? (partnerPos == 1 ? colUp : partnerPos == -1 ? colDn : txtC) : hide, bgcolor = cb, text_size = size.small)
table.cell(dash, 0, 5, showTable ? "Fut OI · STATE" : "", text_color = tc, bgcolor = hb, text_size = size.small)
table.cell(dash, 1, 5, showTable ? futSym + " " + fmtOI(futOI) + " · " + futClass : "", text_color = tc, bgcolor = cb, text_size = size.small)
table.cell(dash, 2, 5, showTable ? state : "", text_color = showTable ? color.white : hide, bgcolor = showTable ? stateCol : hide, text_size = size.small)

// ───────── Alerts ─────────
stateChanged = state != state[1]
alertcondition(stateChanged and state == "LONG SETUP", "OPP: Long setup", "Option Pulse Pro {{ticker}} {{interval}}: LONG SETUP")
alertcondition(stateChanged and state == "SHORT SETUP", "OPP: Short setup", "Option Pulse Pro {{ticker}} {{interval}}: SHORT SETUP")
alertcondition(stateChanged and state == "PREMIUM DECAY", "OPP: Premium decay", "Option Pulse Pro {{ticker}} {{interval}}: PREMIUM DECAY — avoid")
alertcondition(stateChanged, "OPP: Any state change", "Option Pulse Pro {{ticker}} {{interval}}: state changed")
alertcondition(not na(ta.change(stDir)) and ta.change(stDir) != 0 and stDir < 0, "OPP: Main Trend turned bullish", "Option Pulse Pro {{ticker}} {{interval}}: Main Trend turned bullish")
alertcondition(not na(ta.change(stDir)) and ta.change(stDir) != 0 and stDir > 0, "OPP: Main Trend turned bearish", "Option Pulse Pro {{ticker}} {{interval}}: Main Trend turned bearish")
